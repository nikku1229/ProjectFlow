{
  "info": {
    "name": "ProjectFlow API",
    "_postman_id": "projectflow-collection-v1",
    "description": "Mini Project Management System - Complete API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "TOKEN", "value": "", "type": "string" },
    { "key": "PROJECT_ID", "value": "", "type": "string" },
    { "key": "TASK_ID", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code === 201){ pm.collectionVariables.set('TOKEN', pm.response.json().token); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{BASE_URL}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login User",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code === 200){ pm.collectionVariables.set('TOKEN', pm.response.json().token); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{BASE_URL}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code === 201){ pm.collectionVariables.set('PROJECT_ID', pm.response.json().data._id); }"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{BASE_URL}}/projects",
            "body": { "mode": "raw", "raw": "{\n  \"projectName\": \"My First Project\",\n  \"description\": \"This is a test project\"\n}" }
          }
        },
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/projects"
          }
        },
        {
          "name": "Get Single Project",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/projects/{{PROJECT_ID}}"
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{BASE_URL}}/projects/{{PROJECT_ID}}",
            "body": { "mode": "raw", "raw": "{\n  \"projectName\": \"Updated Project Name\",\n  \"description\": \"Updated description\"\n}" }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/projects/{{PROJECT_ID}}"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Add Task",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code === 201){ pm.collectionVariables.set('TASK_ID', pm.response.json().data._id); }"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{BASE_URL}}/projects/{{PROJECT_ID}}/tasks",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Design Homepage\",\n  \"description\": \"Create wireframes and mockups\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2025-02-28\"\n}" }
          }
        },
        {
          "name": "Get All Tasks (with filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/projects/{{PROJECT_ID}}/tasks?page=1&limit=10&status=todo",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "todo", "description": "Filter: todo | in-progress | completed" }
              ]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{BASE_URL}}/projects/{{PROJECT_ID}}/tasks/{{TASK_ID}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Design Homepage (Updated)\",\n  \"description\": \"Finalized wireframes\",\n  \"status\": \"in-progress\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2025-03-01\"\n}" }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": "{{BASE_URL}}/projects/{{PROJECT_ID}}/tasks/{{TASK_ID}}"
          }
        }
      ]
    }
  ]
}
